{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": ["src/**/*.ts", "packages/wft-router/src/**/*.ts"],
  "entry": ["packages/wft-router/src/bin/wft-router.ts"],
  "ignoreDependencies": [
    "pino-pretty",
    "@stryker-mutator/api",
    // Loaded via a dynamic string-specifier import in
    // src/cli/commands/self-update.ts (`const specifier = 'update-notifier';
    // await import(specifier)`) so the self-update nudge degrades silently when
    // absent. knip can't follow that indirection statically and false-positives
    // it as unused — it IS a runtime dependency, do NOT remove it.
    "update-notifier"
  ],
  "ignoreBinaries": [
    // `p4` (Perforce CLI) is on the SCM exec allowlist and is spawned directly
    // (`spawnSync('p4', ...)`) by the env-gated real-p4d integration suite's
    // docker helper (src/scm/__tests__/helpers/p4d-docker.ts) — a PATH-resolved
    // external binary, never an npm dependency. `gh`, also on the allowlist, is
    // never spawned by a literal command knip can see, so it needs no entry
    // (knip reports an unneeded ignore as a configuration hint).
    "p4"
  ]
}
